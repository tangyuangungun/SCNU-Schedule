#!/bin/sh
set -eu

terms_file="$(git config --get privacy.termsFile || true)"
files_tmp="$(mktemp)"
blob_tmp="$(mktemp)"
trap 'rm -f "$files_tmp" "$blob_tmp"' EXIT

git diff --cached --name-only --diff-filter=ACM -z > "$files_tmp"
failed=0

while IFS= read -r -d '' file; do
    git show ":$file" > "$blob_tmp" 2>/dev/null || continue

    if grep -aEq '1[3-9][0-9]{9}|DEFAULT_PASSWORD[[:space:]]*=[[:space:]]*os\.getenv\([^,]+,[[:space:]]*["'"'"'][^"'"'"']+["'"'"']|DEFAULT_ACCOUNT[[:space:]]*=[[:space:]]*os\.getenv\([^,]+,[[:space:]]*["'"'"'][0-9]{7,}["'"'"']|C:\\Users\\|D:\\codex\\|/Users/|/home/' "$blob_tmp"; then
        echo "Privacy guard blocked a generic personal-data pattern in: $file" >&2
        failed=1
    fi

    if [ -n "$terms_file" ] && [ -f "$terms_file" ]; then
        while IFS= read -r term; do
            [ -z "$term" ] && continue
            case "$term" in \#*) continue ;; esac
            if grep -aFq -- "$term" "$blob_tmp"; then
                echo "Privacy guard blocked a private term in: $file" >&2
                failed=1
            fi
        done < "$terms_file"
    fi
done < "$files_tmp"

if [ "$failed" -ne 0 ]; then
    echo "Commit blocked. Remove the highlighted private data or update the guarded files." >&2
    exit 1
fi